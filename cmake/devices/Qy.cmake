include_guard(GLOBAL)

function(infiniccl_detect_qy output)
    set(_found FALSE)
    foreach(_qy_env QY_ROOT QY_HOME QY_PATH)
        if(DEFINED ENV{${_qy_env}} AND EXISTS "$ENV{${_qy_env}}/sdk/include/cuda_runtime.h")
            set(_found TRUE)
            break()
        endif()
    endforeach()
    if(NOT _found AND EXISTS "/usr/local/dlgpu/sdk/include/cuda_runtime.h")
        set(_found TRUE)
    endif()
    if(NOT _found AND EXISTS "/usr/local/denglin/sdk/include/cuda_runtime.h")
        set(_found TRUE)
    endif()
    set(${output} ${_found} PARENT_SCOPE)
endfunction()

function(infiniccl_configure_qy)
    set(QY_ROOT "")
    foreach(_qy_env QY_ROOT QY_HOME QY_PATH)
        if(NOT QY_ROOT AND DEFINED ENV{${_qy_env}} AND NOT "$ENV{${_qy_env}}" STREQUAL "")
            set(QY_ROOT "$ENV{${_qy_env}}")
        endif()
    endforeach()
    if(NOT QY_ROOT AND EXISTS "/usr/local/dlgpu/sdk/bin/dlcc")
        set(QY_ROOT "/usr/local/dlgpu")
    endif()
    if(NOT QY_ROOT AND EXISTS "/usr/local/denglin/sdk/bin/dlcc")
        set(QY_ROOT "/usr/local/denglin")
    endif()
    if(NOT QY_ROOT OR NOT EXISTS "${QY_ROOT}/sdk/include/cuda_runtime.h")
        message(FATAL_ERROR
            "`WITH_QY` is `ON` but Denglin QY SDK was not found. "
            "Set `QY_ROOT` (expected `sdk/include/cuda_runtime.h`).")
    endif()
    set(QY_ROOT "${QY_ROOT}" CACHE PATH "Denglin QY SDK root" FORCE)
    set(QY_SDK "${QY_ROOT}/sdk" PARENT_SCOPE)
    set(QY_SDK "${QY_ROOT}/sdk" CACHE PATH "Denglin QY SDK path" FORCE)
    find_library(QY_CURT_LIB NAMES curt HINTS "${QY_ROOT}/sdk/lib" "${QY_ROOT}/sdk/lib64" REQUIRED)
    set(QY_CURT_LIB "${QY_CURT_LIB}" PARENT_SCOPE)
    include_directories("${QY_ROOT}/sdk/include")
    link_directories("${QY_ROOT}/sdk/lib" "${QY_ROOT}/sdk/lib64")
    message(STATUS "QY: SDK ${QY_ROOT}/sdk, curt ${QY_CURT_LIB}")
endfunction()
