include_guard(GLOBAL)

include(CheckCXXSourceCompiles)
include(CMakePushCheckState)

# Probes optional CCL API operations against the selected SDK and generates a
# namespace of Boolean constants, one per vendor spelling plus one aggregated
# per-operation alias.
#
# ```
# infiniccl_configure_ccl_capabilities(
#     PROVIDER <provider>                  # capability namespace provider
#     HEADER <header>                      # include used by every probe
#     OPS <Op>|<call>[|<call>] ...         # operations and vendor spellings
#     [INCLUDES <dirs...>]                 # probe include directories
#     [LIBRARIES <libs...>]                # probe link libraries
#     [DEFINITIONS <defs...>]              # probe compile definitions
# )
# ```
#
# Each `OPS` entry describes one operation: `<Op>` is its name (without the
# provider prefix) followed by one C++ call expression per vendor spelling of
# the same functionality, separated by `|` (call expressions must not contain
# `|`). Every spelling is probed independently by compiling and linking a
# call against the provider SDK. The generated
# `${CMAKE_BINARY_DIR}/src/backends/ccl/<provider>/capabilities.h` defines, per
# operation:
#     `kHas<Op>`            first spelling is available
#     `kHas<Op>Alternate`   second spelling is available
#     `kHasNative<Op>`      any declared spelling is available
#
# Probe results are cached in
# `<build>/src/backends/ccl/<provider>/capabilities.stamp`. The stamp
# records an MD5 over everything that can change
# probe outcomes: the op registry, the probe header, include directories,
# library paths with file mtimes, and compile definitions. A configure whose
# fingerprint matches reuses the stored results and skips every probe; any
# registry or SDK change (including a library mtime bump) re-probes. The
# generated header is rewritten only when its content differs, so no-op
# reconfigures leave the file mtime — and therefore includers — untouched.
function(infiniccl_configure_ccl_capabilities)
    set(_options)
    set(_one_value_args PROVIDER HEADER)
    set(_multi_value_args OPS INCLUDES LIBRARIES DEFINITIONS)
    cmake_parse_arguments(CAP "${_options}" "${_one_value_args}"
        "${_multi_value_args}" ${ARGN})

    if(NOT CAP_PROVIDER)
        message(FATAL_ERROR "CCL capabilities require a provider name.")
    endif()
    if(NOT CAP_HEADER)
        message(FATAL_ERROR "CCL capabilities require a header.")
    endif()
    if(NOT CAP_OPS)
        message(FATAL_ERROR "CCL capabilities require operation entries.")
    endif()

    string(TOUPPER "${CAP_PROVIDER}" _provider_upper)
    set(_output
        "${CMAKE_BINARY_DIR}/src/backends/ccl/${CAP_PROVIDER}/capabilities.h")
    set(_stamp
        "${CMAKE_BINARY_DIR}/src/backends/ccl/${CAP_PROVIDER}/capabilities.stamp")

    # ---- SDK fingerprint: everything that can change probe outcomes --------
    set(_fingerprint
        "gen=2.1|provider=${CAP_PROVIDER}|header=${CAP_HEADER}|ops=${CAP_OPS}|includes=${CAP_INCLUDES}|definitions=${CAP_DEFINITIONS}|libraries=${CAP_LIBRARIES}")
    foreach(_lib IN LISTS CAP_LIBRARIES)
        if(EXISTS "${_lib}")
            file(TIMESTAMP "${_lib}" _lib_mtime "%s")
            string(APPEND _fingerprint "|mtime:${_lib}=${_lib_mtime}")
        endif()
    endforeach()
    string(MD5 _fingerprint_md5 "${_fingerprint}")

    set(_reuse FALSE)
    set(_cached_results "")
    if(EXISTS "${_stamp}")
        file(READ "${_stamp}" _stamp_text)
        string(REPLACE "
" ";" _stamp_lines "${_stamp_text}")
        list(GET _stamp_lines 0 _stamp_md5)
        list(LENGTH _stamp_lines _stamp_line_count)
        if(_stamp_line_count GREATER 1 AND "${_stamp_md5}" STREQUAL "${_fingerprint_md5}")
            list(GET _stamp_lines 1 _cached_csv)
            string(REPLACE "," ";" _cached_results "${_cached_csv}")
            set(_reuse TRUE)
        endif()
    endif()

    if(_reuse)
        message(STATUS
            "CCL[${CAP_PROVIDER}] capabilities: SDK fingerprint unchanged, reusing cached probe results")
    else()
        list(LENGTH CAP_OPS _op_count)
        message(STATUS
            "CCL[${CAP_PROVIDER}] capabilities: probing ${_op_count} operation(s) against the selected SDK")
    endif()

    string(CONCAT _content
        "#ifndef INFINI_CCL_BACKENDS_CCL_${_provider_upper}_CAPABILITIES_H_\n"
        "#define INFINI_CCL_BACKENDS_CCL_${_provider_upper}_CAPABILITIES_H_\n"
        "\n"
        "// Generated by infiniccl_configure_ccl_capabilities() at configure\n"
        "// time from compile-link probes against the selected SDK. Do not edit.\n"
        "\n"
        "#include \"device.h\"\n"
        "\n"
        "namespace infini::ccl::${CAP_PROVIDER}::capabilities {\n"
    )

    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_INCLUDES ${CAP_INCLUDES})
    set(CMAKE_REQUIRED_LIBRARIES ${CAP_LIBRARIES})
    set(CMAKE_REQUIRED_DEFINITIONS ${CAP_DEFINITIONS})
    list(TRANSFORM CMAKE_REQUIRED_DEFINITIONS PREPEND "-D")

    set(_probe_index 0)
    set(_results_csv "")
    set(_declared_ops "")
    foreach(_op_entry IN LISTS CAP_OPS)
        string(REPLACE "|" ";" _op_parts "${_op_entry}")
        list(GET _op_parts 0 _op_name)
        if(_op_name IN_LIST _declared_ops)
            message(FATAL_ERROR
                "Operation ${_op_name} is declared more than once.")
        endif()
        list(APPEND _declared_ops "${_op_name}")

        list(LENGTH _op_parts _spelling_count)
        if(_spelling_count LESS 2 OR _spelling_count GREATER 3)
            message(FATAL_ERROR
                "Operation ${_op_name} needs one or two vendor spellings.")
        endif()

        set(_alias_terms "")
        set(_native_spelling 0)
        math(EXPR _last_spelling_index "${_spelling_count} - 1")
        foreach(_spelling_index RANGE 1 "${_last_spelling_index}")
            list(GET _op_parts "${_spelling_index}" _call)
            if(_spelling_index EQUAL 1)
                set(_constant "kHas${_op_name}")
            else()
                set(_constant "kHas${_op_name}Alternate")
            endif()

            if(_reuse)
                list(GET _cached_results ${_probe_index} _available)
            else()
                set(_result_var "_INFINICCL_${_provider_upper}_${_constant}")
                unset("${_result_var}" CACHE)
                unset("${_result_var}")
                set(_source "\n#include \"${CAP_HEADER}\"\nint main() {\n    ${_call};\n}\n")
                check_cxx_source_compiles("${_source}" "${_result_var}")

                set(_available 0)
                if(${_result_var})
                    set(_available 1)
                endif()
            endif()
            math(EXPR _probe_index "${_probe_index} + 1")
            string(APPEND _results_csv "${_available},")

            if(_available AND _native_spelling EQUAL 0)
                set(_native_spelling ${_spelling_index})
            endif()

            string(APPEND _content
                "template <Device::Type device>\n"
                "inline constexpr bool ${_constant} = ${_available};\n")
            list(APPEND _alias_terms "${_constant}<device>")
        endforeach()

        math(EXPR _spelling_total "${_spelling_count} - 1")
        if(_native_spelling GREATER 0)
            message(STATUS
                "CCL[${CAP_PROVIDER}] ${_op_name}: native (spelling ${_native_spelling} of ${_spelling_total})")
        else()
            message(STATUS
                "CCL[${CAP_PROVIDER}] ${_op_name}: no native API in this SDK (fallback)")
        endif()

        string(REPLACE ";" " || " _alias_expr "${_alias_terms}")
        string(APPEND _content
            "template <Device::Type device>\n"
            "inline constexpr bool kHasNative${_op_name} = ${_alias_expr};\n")
    endforeach()

    cmake_pop_check_state()

    string(APPEND _content
        "\n"
        "}  // namespace infini::ccl::${CAP_PROVIDER}::capabilities\n"
        "\n"
        "#endif  // INFINI_CCL_BACKENDS_CCL_${_provider_upper}_CAPABILITIES_H_\n"
    )

    if(NOT _reuse)
        string(REGEX REPLACE ",$" "" _results_csv "${_results_csv}")
        file(WRITE "${_stamp}" "${_fingerprint_md5}\n${_results_csv}")
    endif()

    # ---- Emit the header only when its content actually changes ------------
    set(_header_changed TRUE)
    if(EXISTS "${_output}")
        file(READ "${_output}" _existing_content)
        if(_existing_content STREQUAL "${_content}")
            set(_header_changed FALSE)
        endif()
    endif()
    if(_header_changed)
        file(WRITE "${_output}" "${_content}")
        message(STATUS
            "CCL[${CAP_PROVIDER}] capabilities: wrote ${_output}")
    else()
        message(STATUS
            "CCL[${CAP_PROVIDER}] capabilities: ${_output} unchanged")
    endif()
endfunction()
